rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Las imágenes públicas (mapa, landing, tech tree) se leen sin autenticación
    match /map-assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /landing-assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /tech_tree_images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /archetypes-assets/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    match /journey-assets/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    match /personajes-assets/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    // Sellos/firmas de cotizaciones: solo lectura pública del enlace compartido
    match /cotizaciones/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Activos de la tienda / Mercado (fotos de productos, portadas de libros, sets didácticos)
    match /mercado-assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Portadas de relatos e ilustraciones de la Gran Biblioteca (subidas por estudiantes autenticados)
    match /gran_galeria_portadas/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /gran_galeria_arte/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /gran_galeria_videos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Cualquier otra ruta: lectura pública, escritura solo para usuarios autenticados
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
