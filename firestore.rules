rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Un usuario es administrador si tiene el custom claim token.admin == true
    // o si su documento en /users/{uid} tiene role == 'admin'.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Configuración general del portal
    match /config/portal {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Colección de inscripciones de maestros
    match /inscripciones/{inscripcion} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Colección de cotizaciones web (enlaces públicos)
    match /cotizaciones/{cotizacionId} {
      allow read: if true; // Lectura pública para que el cliente vea el link
      allow write: if isAdmin(); // Solo admin (gerencia) puede crear/modificar
    }

    // Colección de juegos de bingo
    match /bingo_games/{gameId} {
      allow read: if true;
      allow write: if request.auth != null; // El host debe iniciar sesión para administrar la partida
    }

    // Colección de cartones de bingo
    match /bingo_cards/{cardId} {
      allow read, create, update: if true; // Los jugadores anónimos registran su cartón
      allow delete: if request.auth != null;
    }

    // Colección de historial de ganadores
    match /bingo_winners_history/{winnerId} {
      allow read: if true;
      allow create, update: if request.auth != null; // Solo el host autenticado confirma ganadores
      allow delete: if request.auth != null;
    }

    // Colección de códigos de activación para Bingo
    match /bingo_codes/{codeId} {
      allow read: if true; // Validación pública del código
      allow create: if isAdmin();
      allow update: if request.auth != null; // El host autenticado consume los códigos
      allow delete: if isAdmin();
    }

    // Colección de promotores de Bingo
    match /bingo_promoters/{promoterId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Colección de usuarios del portal (estudiantes, docentes, administradores)
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
