rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Un usuario es administrador si su correo es lluviadeideaseditorial@gmail.com,
    // si tiene el custom claim token.admin == true o si su documento en /users/{uid} tiene role == 'admin'.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'lluviadeideaseditorial@gmail.com'
        || request.auth.token.admin == true
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Configuración general del portal y submódulos
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Colección dedicada para imágenes y assets de arquetipos y viaje del héroe
    // Cada arquetipo o etapa tiene su propio documento de hasta 1 MiB independiente
    match /archetype_assets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Colección de inscripciones de maestros
    match /inscripciones/{inscripcion} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Colección de cotizaciones web (enlaces públicos)
    match /cotizaciones/{cotizacionId} {
      allow read: if true; // Lectura pública para que el cliente vea el link
      allow write: if isAdmin(); // Solo admin (gerencia) puede crear/modificar
    }

    // Colección de juegos de bingo
    match /bingo_games/{gameId} {
      allow read: if true;
      // El Host autenticado administra la partida completa.
      // Los jugadores anónimos pueden actualizar atómicamente 'activeClaim' y 'lastBingoShoutAt' para cantar Bingo
      allow update: if request.auth != null || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeClaim', 'lastBingoShoutAt']));
      allow create, delete: if request.auth != null;
    }

    // Colección de cartones de bingo
    match /bingo_cards/{cardId} {
      allow read: if true;
      allow create: if request.resource.data.gameId is string;
      allow update: if request.resource.data.gameId == resource.data.gameId;
      allow delete: if request.auth != null;
    }

    // Colección de historial de ganadores
    match /bingo_winners_history/{winnerId} {
      allow read: if true;
      allow create, update: if request.auth != null; // Solo el host autenticado confirma ganadores
      allow delete: if request.auth != null;
    }

    // Colección de códigos de activación para Bingo
    match /bingo_codes/{codeId} {
      allow read: if true; // Validación pública del código
      allow create: if isAdmin();
      allow update: if request.auth != null; // El host autenticado consume los códigos
      allow delete: if isAdmin();
    }

    // Colección de promotores de Bingo
    match /bingo_promoters/{promoterId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Colección de órdenes y compras de boletos de Bingo (Recurrente)
    match /bingo_orders/{orderId} {
      allow create: if true; // Cualquier jugador público puede iniciar la orden de compra
      allow read, update: if true; // Lectura y actualización de estado tras retorno de pasarela
      allow delete: if isAdmin();
    }

    // Configuración general de Bingo (pasarelas de pago, etc.)
    match /bingo_settings/{settingId} {
      allow read: if true; // Lectura pública de links y configuraciones
      allow write: if isAdmin(); // Solo gerencia puede modificar
    }

    // Colección de usuarios del portal (estudiantes, docentes, administradores)
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;

      // Subcolecciones de usuario (progreso en Sutz, inventarios, etc.)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }
  }
}
